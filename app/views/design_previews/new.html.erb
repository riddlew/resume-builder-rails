<%= render layout: 'layouts/app_layout' do %>

  <%# Page header %>
  <div class="mb-8">
	<div class="flex justify-between items-baseline">
		<h1 class="font-serif font-medium text-[30px] tracking-tight leading-tight text-ink mb-2">Tailor a new resume</h1>
		<span class="inline-flex items-center gap-[5px] px-2 py-0.5 rounded-full bg-surface-alt border border-border text-[11.5px] text-ink-muted">
			<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>
			Using profile · Alex Morgan
		</span>
	</div>
    <p class="text-[14.5px] text-ink-muted leading-[1.55] m-0" style="max-width: 540px;">
      Paste a job description or a link, pick a template, and we'll grade
      your profile against the role and propose targeted edits.
    </p>
  </div>

  <%# Card 1: Job source %>
  <div class="bg-surface border border-border rounded-[14px] overflow-hidden mb-4" style="padding: 20px 22px;">

    <%# Card header %>
    <div class="flex items-center justify-between mb-3">
      <label class="block text-[12px] font-medium text-ink-muted tracking-[0.005em] m-0">Job source</label>
      <button class="inline-flex items-center h-[26px] px-3 rounded-[10px] text-[12px] font-medium text-ink-muted hover:bg-surface-hover hover:text-ink transition-colors">
        Try with sample job →
      </button>
    </div>

    <%# Segmented toggle %>
    <div class="mb-[14px]">
      <div class="inline-flex bg-surface-alt border border-border rounded-lg p-[3px]">
        <button class="inline-flex items-center gap-1.5 px-3.5 py-1.5 text-[12.5px] font-medium rounded-md text-ink-muted transition-colors">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
          </svg>
          Job link
        </button>
        <button class="inline-flex items-center gap-1.5 px-3.5 py-1.5 text-[12.5px] font-medium rounded-md bg-surface text-ink shadow-[0_1px_2px_rgba(0,0,0,0.05),0_0_0_1px_var(--color-border)] transition-colors">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/>
          </svg>
          Paste description
        </button>
      </div>
    </div>

    <%# Textarea (paste mode — default) %>
    <textarea
      class="w-full border border-border rounded-[10px] text-[13.5px] text-ink bg-surface outline-none resize-y leading-[1.55] placeholder:text-ink-faint focus:border-accent focus:ring-3 focus:ring-accent-soft transition-colors"
      style="padding: 10px 12px; min-height: 160px;"
      placeholder="Paste the full job description here. Include responsibilities, requirements, and nice-to-haves for the best results."
    ></textarea>
    <div class="text-[11.5px] text-ink-soft mt-1.5 leading-[1.5]">
      Tip: include the full posting — responsibilities, requirements, and nice-to-haves.
    </div>

  </div>

  <%# Card 2: Resume template %>
  <div class="bg-surface border border-border rounded-[14px] overflow-hidden mb-4" style="padding: 20px 22px;">

    <label class="block text-[12px] font-medium text-ink-muted tracking-[0.005em] mb-1.5">Resume template</label>

    <%# Dropdown trigger (static) %>
    <button class="w-full flex items-center justify-between border border-border rounded-[10px] text-[13.5px] text-ink bg-surface hover:border-border-strong transition-colors" style="padding: 10px 12px;">
      <span class="flex items-baseline gap-2">
        <span>Modern</span>
        <span class="text-[12px] text-ink-soft">Clean single-column</span>
      </span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-ink-soft shrink-0">
        <path d="m6 9 6 6 6-6"/>
      </svg>
    </button>

    <%# Template preview %>
    <div class="mt-4">
      <div class="text-[11px] font-medium text-ink-soft uppercase tracking-[0.06em] mb-2">Preview</div>
      <div class="bg-surface-alt border border-border rounded-[10px]" style="padding: 18px;">
        <div class="bg-white rounded-[4px] shadow-[0_4px_16px_rgba(0,0,0,0.06)] overflow-hidden" style="aspect-ratio: 8.5 / 11; padding: 20px 22px; display: flex; flex-direction: column; gap: 8px; font-family: var(--font-sans);">
          <%# Name header %>
          <div style="padding-bottom: 6px; margin-bottom: 4px;">
            <div style="font-size: 13px; font-weight: 600; letter-spacing: -0.01em; color: #1A1A1A;">Alex Morgan</div>
            <div style="font-size: 7.5px; color: #8A877E; margin-top: 2px;">San Francisco · alexmorgan.dev · github.com/amorgan</div>
          </div>
          <%# Summary section %>
          <div style="font-size: 7.5px; font-weight: 600; border-bottom: 0.5px solid #1A1A1A; padding-bottom: 1px; text-transform: uppercase; letter-spacing: 0.08em; color: #1A1A1A;">Summary</div>
          <div style="height: 4px; background: #F4F3EE; border-radius: 2px; width: 92%;"></div>
          <div style="height: 4px; background: #F4F3EE; border-radius: 2px; width: 78%;"></div>
          <%# Experience section %>
          <div style="font-size: 7.5px; font-weight: 600; border-bottom: 0.5px solid #1A1A1A; padding-bottom: 1px; text-transform: uppercase; letter-spacing: 0.08em; color: #1A1A1A; margin-top: 4px;">Experience</div>
          <div style="height: 4px; background: #F4F3EE; border-radius: 2px; width: 85%;"></div>
          <div style="height: 4px; background: #F4F3EE; border-radius: 2px; width: 70%;"></div>
          <div style="height: 4px; background: #F4F3EE; border-radius: 2px; width: 88%;"></div>
          <div style="height: 4px;"></div>
          <div style="height: 4px; background: #F4F3EE; border-radius: 2px; width: 75%;"></div>
          <div style="height: 4px; background: #F4F3EE; border-radius: 2px; width: 82%;"></div>
          <%# Education section %>
          <div style="font-size: 7.5px; font-weight: 600; border-bottom: 0.5px solid #1A1A1A; padding-bottom: 1px; text-transform: uppercase; letter-spacing: 0.08em; color: #1A1A1A; margin-top: 4px;">Education</div>
          <div style="height: 4px; background: #F4F3EE; border-radius: 2px; width: 65%;"></div>
          <div style="height: 4px; background: #F4F3EE; border-radius: 2px; width: 50%;"></div>
        </div>
      </div>
    </div>

  </div>

  <%# Submit row %>
  <div class="flex justify-end">
    <button class="inline-flex items-center gap-2 h-10 px-[18px] text-[14px] font-medium bg-accent text-white rounded-[10px] hover:bg-accent-hover transition-colors">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M5.6 18.4l2.1-2.1M16.3 7.7l2.1-2.1"/>
      </svg>
      Generate tailored resume
    </button>
  </div>

<% end %>
