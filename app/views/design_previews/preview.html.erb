<%= render layout: 'layouts/app_layout' do %>

  <%# Top action row %>
  <div class="flex items-center justify-between mb-5" style="max-width: 980px; margin-left: auto; margin-right: auto; margin-bottom: 20px;">
    <div class="flex items-center gap-2.5">
      <%= link_to edit_path, class: "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg font-medium text-ink-muted hover:bg-surface-hover hover:text-ink transition-colors" do %>
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        Back to edits
      <% end %>
    </div>
    <div class="flex gap-2">
      <button class="inline-flex items-center gap-1.5 h-8 px-[14px] rounded-[10px] text-[13px] font-medium bg-surface border border-border text-ink hover:bg-surface-hover hover:border-border-strong transition-colors">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
        Preview PDF
      </button>
      <button class="inline-flex items-center gap-1.5 h-8 px-[14px] rounded-[10px] text-[13px] font-medium bg-ink text-canvas hover:bg-black transition-colors">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l5 5 5-5"/><path d="M12 15V3"/></svg>
        Download
      </button>
    </div>
  </div>

  <div class="flex items-center text-lg font-semibold text-ink gap-2.5 justify-center mb-5" style="max-width: 980px; margin-left: auto; margin-right: auto; margin-bottom: 20px;">
    <span class="font-medium text-ink">Staff Frontend Engineer · Notion</span>
    <span class="inline-flex items-center gap-2 rounded-full text-[12px] font-semibold" style="background: #DEEDE4; color: #3F8061; padding: 4px 10px 4px 5px;">
      <span class="w-[18px] h-[18px] rounded-full grid place-items-center text-white text-[10px] font-bold" style="background: #3F8061;">H</span>
      Hire
      <span style="opacity: 0.65; font-weight: 500; font-variant-numeric: tabular-nums;">84</span>
    </span>
  </div>

  <%# Resume %>
  <div class="resume">
    <h1>Alex Morgan</h1>
    <div class="res-contact">San Francisco, CA · alex.morgan@hey.com · (415) 555-0142</div>
    <div class="res-contact" style="margin-bottom: 12px;">alexmorgan.dev · github.com/amorgan · linkedin.com/in/alexmorgan</div>

    <h2>Summary</h2>
    <p style="margin: 0;">Senior frontend engineer with 8+ years architecting real-time collaborative products at consumer scale. Deep expertise in TypeScript, React, and performance-critical UI. Recent focus on collaboration primitives, editor architecture, and the design-engineering boundary.</p>

    <h2>Experience</h2>

    <div class="res-job">
      <div class="res-job-head">
        <div>
          <span class="res-job-title">Senior Software Engineer</span>
          <span style="color: #444;">, Linear</span>
        </div>
        <div class="res-job-meta">Mar 2022 – Present · Remote</div>
      </div>
      <ul>
        <li>Architected the rebuild of the issue search system used across 200k+ workspaces, cutting p95 query latency from 850ms to 120ms — a pattern transferable to editor query/index workloads.</li>
        <li>Designed and shipped the Cycles automation engine end-to-end, adopted by 40% of paying customers in the first quarter — owned scope from spec through real-time client sync.</li>
        <li>Mentored four mid-level engineers — two promoted within 12 months — and led architecture reviews for the editor team, raising the technical bar across the org.</li>
        <li>Drove migration from REST to a typed RPC layer, reducing client bundle size by 22% — a meaningful win for editor cold-start performance.</li>
        <li>Owned weekly on-call rotation; cut average incident response time by 40% through runbook automation.</li>
      </ul>
    </div>

    <div class="res-job">
      <div class="res-job-head">
        <div>
          <span class="res-job-title">Software Engineer</span>
          <span style="color: #444;">, Stripe</span>
        </div>
        <div class="res-job-meta">Jul 2019 – Feb 2022 · San Francisco, CA</div>
      </div>
      <ul>
        <li>Built consumer-grade charting UI used by 1M+ merchants daily, rendering 4B+ data points per day with virtualized canvas pipelines.</li>
        <li>Reduced dashboard initial load from 4.2s to 1.1s through code-splitting, edge caching, and aggressive React render budgeting — performance work directly applicable to editor cold-start.</li>
        <li>Shipped Stripe Sigma SQL editor v2, a Monaco-based query environment with autocomplete and schema introspection — first hands-on experience with editor frameworks.</li>
        <li>Partnered with design to establish the dashboard's component library, now used across 30+ surfaces.</li>
      </ul>
    </div>

    <div class="res-job">
      <div class="res-job-head">
        <div>
          <span class="res-job-title">Software Engineer</span>
          <span style="color: #444;">, Asana</span>
        </div>
        <div class="res-job-meta">Jul 2017 – Jun 2019 · San Francisco, CA</div>
      </div>
      <ul>
        <li>Built the Timeline view feature from spec to launch, used by 60% of paying teams within six months.</li>
        <li>Improved real-time sync reliability by introducing operational transform conflict resolution.</li>
        <li>Onboarded as a new grad; promoted to mid-level within 18 months.</li>
      </ul>
    </div>

    <h2>Education</h2>

    <div class="res-job">
      <div class="res-job-head">
        <div>
          <span class="res-job-title">B.S. Computer Science</span>
          <span style="color: #444;">, Carnegie Mellon University</span>
        </div>
        <div class="res-job-meta">2013 – 2017 · Pittsburgh, PA</div>
      </div>
      <div style="font-size: 10pt; color: #444; margin-top: 2px;">Minor in Human-Computer Interaction. GPA 3.8/4.0.</div>
    </div>

    <h2>Skills</h2>
    <div style="font-family: var(--font-sans); font-size: 10pt; line-height: 1.6;">
      TypeScript · React · Real-time collaboration · Operational Transform · Performance optimization · System design · Design systems · GraphQL · Node.js · PostgreSQL
    </div>
  </div>

<% end %>
